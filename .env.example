EBT_DB_PASSWORD=change-me-db-password
EBT_JWT_KEY=change-me-to-a-random-string-of-at-least-32-chars
EBT_ADMIN_USER=admin
EBT_ADMIN_PASSWORD=change-me-admin-password
EBT_DBF_DIR=./legacy
EBT_SWAGGER=false
EBT_ALLOWED_HOSTS=localhost
EBT_BEHIND_PROXY=false
# Longest idle lock in minutes (0..480). 0 = no cap. With a cap, users who chose "never" or a longer lock are locked after this many idle minutes.
EBT_MAX_IDLE_MINUTES=0
# E-mail sent from the system (quote to the customer). Leave EBT_SMTP_HOST empty to keep sending off; the quote screen then only offers "Registrar envio".
# Port 465 uses SSL from the first byte (Locaweb email-ssl.com.br); port 587 uses STARTTLS. EBT_SMTP_SECURITY: Auto (default, decides by the port), Ssl, StartTls or None.
EBT_SMTP_HOST=
EBT_SMTP_PORT=587
EBT_SMTP_USER=
EBT_SMTP_PASSWORD=
EBT_SMTP_FROM=
EBT_SMTP_FROM_NAME=EBT
EBT_SMTP_SECURITY=Auto
# Alerts: e-mail (several addresses separated by ;) told when the backup fails, the backup agent goes silent, the last restore drill failed or the database is unavailable.
# Needs the EBT_SMTP_* settings above. Empty = off. At most one mail every 6 hours while the problem lasts.
EBT_ALERT_TO=
# Optional TLS proxy (docker compose --profile proxy up -d caddy): the public name users type, and the certificate source ("internal" = Caddy's own CA).
# With the proxy also set EBT_BEHIND_PROXY=true, EBT_ALLOWED_HOSTS=<this name> and EBT_CORS_ORIGIN=https://<this name>.
EBT_PUBLIC_HOST=localhost
EBT_CADDY_TLS=internal
# Sizing: Npgsql connection pool per API process and container memory limits.
EBT_DB_POOL=40
EBT_API_MEM=512m
EBT_DB_MEM=1g
