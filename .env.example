EBT_DB_PASSWORD=change-me-db-password
EBT_JWT_KEY=change-me-to-a-random-string-of-at-least-32-chars
EBT_ADMIN_USER=admin
EBT_ADMIN_PASSWORD=change-me-admin-password
EBT_DBF_DIR=./legacy
EBT_SWAGGER=false
EBT_ALLOWED_HOSTS=localhost
EBT_BEHIND_PROXY=false
# Longest idle lock in minutes (0..480). 0 = no cap. With a cap, users who chose "never" or a longer lock are locked after this many idle minutes.
EBT_MAX_IDLE_MINUTES=0
# E-mail sent from the system (quote to the customer). Leave EBT_SMTP_HOST empty to keep sending off; the quote screen then only offers "Registrar envio".
# Port 587 with STARTTLS is the usual setting (Microsoft 365, Gmail with an app password, most hosts). Port 465 (implicit SSL) is not supported.
EBT_SMTP_HOST=
EBT_SMTP_PORT=587
EBT_SMTP_USER=
EBT_SMTP_PASSWORD=
EBT_SMTP_FROM=
EBT_SMTP_FROM_NAME=EBT
EBT_SMTP_STARTTLS=true
